{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "SwiftNetworkKit",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "draft": false,
      "prerelease": false,
      "include-component-in-tag": false,
      "extra-files": [
        "version.txt",
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/lib/version.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "Sources/SwiftNetworkKit/SwiftNetworkKit.swift",
          "search": "public static let version = \"[^\"]+\"",
          "replace": "public static let version = \"${version}\""
        },
        {
          "type": "generic",
          "path": "README.md",
          "search": "from: \"[0-9]+\\.[0-9]+\\.[0-9]+[^\"]*\"",
          "replace": "from: \"${version}\""
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "CI" },
    { "type": "chore", "section": "Chores", "hidden": true }
  ]
}
